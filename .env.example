# SESSION_SECRET: HMAC key used to sign the session cookie and the bearer
# token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it out of version control and rotate it to invalidate every session.
SESSION_SECRET="replace-with-a-random-secret-generated-with-openssl-rand-hex-32"

# SESSION_COOKIE_SECURE: forces the "Secure" flag on the session cookie.
# Leave it unset to auto-detect from the request protocol. Set it to "true"
# when the app is served over HTTPS, and to "false" when it is served over
# plain HTTP (for example a forwarded Codespaces port).
# SESSION_COOKIE_SECURE="false"

# MONGODB_URI: required for production; development can use seeded in-memory data.
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/vendhan_sports_academy"

# DEMO_MODE: "true" runs the seeded academy (known demo accounts, in-memory
# store) in any environment, including production. Set it to "false" once a
# real MONGODB_URI and the bootstrap administrator below are configured.
# Without this flag a production deployment refuses to start, because it will
# not fall back to the in-memory demo store on its own.
# DEMO_MODE="true"

# Production bootstrap account. Demo credentials are disabled in production.
# Bootstrap values are used only when no administrator account exists.
# BOOTSTRAP_ADMIN_USERNAME="academy-admin"
# BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-password-at-least-8-chars"
# BOOTSTRAP_ADMIN_NAME="Academy Administrator"

# APP_URL: the public URL of this deployment. Used for self-referential links.
# APP_URL="http://localhost:3000"

# STRIPE_SECRET_KEY: enables real hosted fee checkout. Keep private.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET: signing secret for the Stripe webhook endpoint:
#   https://your-host/api/payments/webhook
# Subscribe to checkout.session.completed.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# WhatsApp Cloud API credentials. Messages go only to explicitly opted-in guardians.
# WHATSAPP_ACCESS_TOKEN="..."
# WHATSAPP_PHONE_NUMBER_ID="..."
# WHATSAPP_API_VERSION="v21.0"
# WHATSAPP_APP_SECRET="..."
# WHATSAPP_WEBHOOK_VERIFY_TOKEN="..."
# WHATSAPP_TEST_TEMPLATE_NAME="hello_world"
# WHATSAPP_TEST_TEMPLATE_LANGUAGE="en_US"
# WHATSAPP_TEMPLATE_LANGUAGE="en_US"
# WHATSAPP_TEMPLATE_EMERGENCY_SCHEDULE_CHANGE="emergency_schedule_change"
# WHATSAPP_TEMPLATE_EVENT_UPDATE="event_update"
# WHATSAPP_TEMPLATE_ANNOUNCEMENT="announcement"
# WHATSAPP_TEMPLATE_ACHIEVEMENT="achievement"
# MEDIA_UPLOAD_DIR="/var/lib/vendhan/media"
# Optional Twilio SMS fallback:
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM_NUMBER="+15551234567"
